<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_ivory"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="الإعدادات"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="بيانات المتجر"
            android:textColor="@color/text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etStoreNameSetting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_rounded"
            android:hint="اسم المتجر"
            android:inputType="textCapWords"
            android:padding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveStoreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="حفظ اسم المتجر"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_emerald" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBiometric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="تفعيل تسجيل الدخول بالبصمة" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="تغيير رمز الدخول"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_emerald" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="8dp"
            android:text="الاشتراك الحالي"
            android:textColor="@color/text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubscriptionExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_rounded"
            android:padding="14dp"
            android:text="جارٍ تحميل معلومات الاشتراك…"
            android:textColor="@color/text_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_rounded"
            android:padding="14dp"
            android:text="لتجديد الاشتراك، تواصل مع مالك التطبيق لمعرفة وسيلة الدفع المتاحة. لا يتم الدفع من داخل التطبيق."
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="رقم التواصل: +967778228995"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="اتصال للاستفسار عن التجديد"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_emerald" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWhatsappSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="مراسلة عبر واتساب"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_emerald" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSmsSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="إرسال رسالة نصية"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_emerald" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="مشاركة طلب التجديد عبر التطبيقات"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_emerald" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="8dp"
            android:text="النسخ الاحتياطي"
            android:textColor="@color/text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackupEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="إنشاء ومشاركة نسخة احتياطية"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_emerald" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="استعادة نسخة احتياطية (غير متاحة)"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_emerald" />

    </LinearLayout>
</ScrollView>
