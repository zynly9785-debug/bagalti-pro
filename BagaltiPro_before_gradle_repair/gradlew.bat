@echo off\r\nsetlocal\r\nset APP_HOME=%~dp0\r\nif exist "%APP_HOME%gradle\wrapper\gradle-wrapper.jar" (\r\n  if defined JAVA_HOME (set JAVACMD=%JAVA_HOME%\\bin\\java.exe) else (set JAVACMD=java)\r\n  "%JAVACMD%" -classpath "%APP_HOME%gradle\wrapper\gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain %*\r\n  exit /b %ERRORLEVEL%\r\n)\r\nwhere gradle >nul 2>nul\r\nif %ERRORLEVEL%==0 (gradle -p "%APP_HOME%" %* & exit /b %ERRORLEVEL%)\r\necho ERROR: Gradle Wrapper JAR is missing and no system Gradle is installed.\r\nexit /b 1\r\n